<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><style>*{box-sizing:border-box;margin:0;padding:0;font-family:sans-serif;}body{background:#0f172a;color:#fff;display:flex;justify-content:center;padding:10px;}.box{background:#1e293b;padding:15px;border-radius:12px;width:100%;max-width:500px;}h2{color:#38bdf8;margin-bottom:10px;text-align:center;}input,select{width:100%;padding:8px;font-size:13px;background:#0f172a;border:1px solid #334155;color:#fff;border-radius:6px;margin-bottom:6px;}button{width:100%;padding:8px;background:#0284c7;color:#fff;border:none;border-radius:6px;font-weight:bold;cursor:pointer;}#main,.modal{display:none;}.sec{font-size:13px;color:#f8fafc;font-weight:bold;margin:10px 0 4px 0;display:flex;justify-content:space-between;align-items:center;}.notice{background:#0f172a;padding:8px;border-radius:6px;font-size:12px;color:#cbd5e1;border:1px solid #334155;}textarea{width:100%;background:#0f172a;color:#fff;border:1px solid #38bdf8;padding:6px;border-radius:6px;font-size:12px;height:45px;display:none;}.tab-menu{display:flex;gap:4px;margin-bottom:10px;}.tab-btn{flex:1;padding:6px;font-size:11px;background:#334155;color:#cbd5e1;border:none;border-radius:6px;cursor:pointer;font-weight:bold;}.tab-btn.active{background:#0284c7;color:#fff;}.week-nav, .month-nav{display:flex;justify-content:space-between;align-items:center;background:#0f172a;padding:6px 10px;border-radius:8px;border:1px solid #334155;margin-bottom:8px;}.week-nav button, .month-nav button{width:auto;padding:4px 8px;font-size:11px;background:#334155;color:#38bdf8;}.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:6px;}.cal-hdr{background:#334155;color:#cbd5e1;font-size:11px;font-weight:bold;padding:6px 0;text-align:center;border-radius:4px;}.cal-hdr.sat{color:#60a5fa;}.cal-hdr.sun{color:#f87171;}.cal-cell{background:#0f172a;border:1px solid #334155;border-radius:6px;padding:4px;min-height:160px;display:flex;flex-direction:column;gap:3px;}.month-cell{background:#111827;border:1px solid #334155;border-radius:6px;padding:3px;min-height:85px;display:flex;flex-direction:column;gap:2px;overflow:hidden;}.item{background:#1e293b;border:1px solid #334155;border-radius:4px;padding:4px;font-size:9px;line-height:1.3;cursor:pointer;}.month-item{background:#1e293b;border-left:2px solid #38bdf8;border-radius:2px;padding:2px 3px;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;color:#f1f5f9;}.add-box{background:#0f172a;padding:8px;border-radius:6px;border:1px solid #334155;margin-top:6px;display:none;}.time-select-row{display:flex;align-items:center;gap:4px;margin-bottom:6px;}.time-select-row select{margin-bottom:0;flex:1;}.modal{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);display:none;justify-content:center;align-items:center;padding:15px;z-index:10;}.modal-box{background:#1e293b;border-radius:12px;padding:15px;width:100%;max-width:300px;border:1px solid #334155;}</style></head><body>

<div id="gate" class="box">
  <h2>비룡대대 교육 일정표</h2>
  <input type="password" id="pw" placeholder="비밀번호 입력">
  <button id="btn-login">입장하기</button>
</div>

<div id="main" class="box">
  <h2 style="font-size:16px;">비룡대대 교육 일정표</h2>

  <div class="tab-menu">
    <button class="tab-btn active" id="btn-tab-week" onclick="switchTab('week')">📅 주간 일정</button>
    <button class="tab-btn" id="btn-tab-month" onclick="switchTab('month')">🗓️ 월간 달력</button>
  </div>
  
  <div class="sec">
    <span id="notice-title-text">📢 주요 공지사항 (주간)</span>
    <button style="width:auto;padding:2px 6px;font-size:10px;background:#334155;color:#38bdf8;" id="btn-notice">수정</button>
  </div>
  <div id="notice-view" class="notice">- 주간 장소: 대강당 (10분 전 집결)<br>- 복장: 전투근무복 지참</div>
  <textarea id="notice-edit"></textarea>

  <div class="sec">
    <span>📅 교육 일정 관리</span>
    <button style="width:auto;padding:2px 6px;font-size:10px;background:#0284c7;" id="btn-add-toggle">+ 교육 등록</button>
  </div>

  <div id="add-form" class="add-box">
    <select id="new-day-type" onchange="toggleDateInput()">
      <option value="week">요일 선택 (현재 주간 기준)</option>
      <option value="exact">특정 날짜 직접 선택 (월간 반영)</option>
    </select>
    
    <div id="div-week-day">
      <select id="new-day">
        <option value="0">월요일</option>
        <option value="1">화요일</option>
        <option value="2">수요일</option>
        <option value="3">목요일</option>
        <option value="4">금요일</option>
        <option value="5">토요일</option>
        <option value="6">일요일</option>
      </select>
    </div>

    <div id="div-exact-date" style="display:none;">
      <input type="date" id="new-exact-date" style="margin-bottom:6px;">
    </div>

    <div style="font-size:11px;color:#94a3b8;margin:2px 0 4px 0;">🕒 계획 시간 선택:</div>
    <div class="time-select-row">
      <select id="start-time-select"></select>
      <span style="font-size:12px;color:#cbd5e1;">~</span>
      <select id="end-time-select"></select>
    </div>

    <input type="text" id="new-unit" placeholder="부대 (예: 1중대)">
    <input type="text" id="new-subject" placeholder="교육 과목명">
    <input type="text" id="new-instructor" placeholder="담당 교관">
    <button id="btn-add-submit" style="background:#16a34a;padding:6px;font-size:11px;">등록하기</button>
  </div>

  <!-- 주간 뷰 영역 -->
  <div id="view-week">
    <div class="week-nav">
      <button onclick="changeWeek(-1)">◀ 이전주</button>
      <span id="week-title" style="font-size:11px;color:#38bdf8;font-weight:bold;"></span>
      <button onclick="changeWeek(1)">다음주 ▶</button>
    </div>
    <div class="cal-grid" id="calendar-grid"></div>
  </div>

  <!-- 월간 뷰 영역 -->
  <div id="view-month" style="display:none;">
    <div class="month-nav">
      <button onclick="changeMonth(-1)">◀ 이전달</button>
      <span id="month-title" style="font-size:11px;color:#38bdf8;font-weight:bold;"></span>
      <button onclick="changeMonth(1)">다음달 ▶</button>
    </div>
    <div class="cal-grid" id="month-grid"></div>
  </div>

</div>

<div id="modal" class="modal">
  <div class="modal-box">
    <h3 id="m-title" style="color:#38bdf8;margin-bottom:6px;font-size:14px;"></h3>
    <div id="m-body" style="font-size:11px;color:#cbd5e1;line-height:1.4;margin-bottom:8px;"></div>
    <div id="m-log" style="font-size:10px;color:#4ade80;margin-bottom:8px;">기록 없음</div>
    <div style="display:flex;gap:4px;margin-bottom:6px;">
      <button style="background:#16a34a;padding:6px;font-size:11px;" id="btn-start">시작 기록</button>
      <button style="background:#dc2626;padding:6px;font-size:11px;" id="btn-end">종료 기록</button>
    </div>
    <button style="background:#7f1d1d;padding:6px;font-size:11px;margin-bottom:6px;" id="btn-delete">🗑️ 이 일정 삭제하기</button>
    <button style="background:#475569;padding:6px;font-size:11px;" id="btn-close">닫기</button>
  </div>
</div>

<script>
let currentTab = 'week';
let currentMonday = getMonday(new Date());
let currentMonthDate = new Date();
let scheduleData = JSON.parse(localStorage.getItem("multiCalData_v14")) || {};
let currentSubId = "";

const holidays = {
  "01-01": "신정",
  "03-01": "삼일절",
  "05-05": "어린이날",
  "06-06": "현충일",
  "08-15": "광복절",
  "10-03": "개천절",
  "10-09": "한글날",
  "12-25": "성탄절"
};

let noticeData = JSON.parse(localStorage.getItem("noticeData_v14")) || {
  week: "- 주간 장소: 대강당 (10분 전 집결)<br>- 복장: 전투근무복 지참",
  month: "- 10월 중점 사항: 전술 평가 준비<br>- 안전사고 예방 철저"
};

function getMonday(d) {
  d = new Date(d);
  let day = d.getDay();
  let diff = d.getDate() - day + (day === 0 ? -6 : 1);
  return new Date(d.setDate(diff));
}

function formatDate(d) {
  let m = d.getMonth() + 1;
  let dt = d.getDate();
  return (m < 10 ? "0" + m : m) + "/" + (dt < 10 ? "0" + dt : dt);
}

function formatFullDate(d) {
  let y = d.getFullYear();
  let m = d.getMonth() + 1;
  let dt = d.getDate();
  return `${y}-${m < 10 ? '0'+m : m}-${dt < 10 ? '0'+dt : dt}`;
}

function getWeekNumber(d) {
  d = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay()||7));
  let yearStart = new Date(Date.UTC(d.getUTCFullYear(),0,1));
  let weekNo = Math.ceil(( ( (d - yearStart) / 86400000) + 1)/7);
  return weekNo;
}

function getWeekKey(monday) {
  return formatFullDate(monday);
}

function seedOctoberData() {
  const sampleSubjects = [
    { u: "1중대", s: "전술학 개론", i: "대위 김비룡" },
    { u: "2중대", s: "화생방 실습", i: "중위 이안보" },
    { u: "3중대", s: "개인화기 사격", i: "상사 박안전" },
    { u: "본부대", s: "정훈 정신전력", i: "소령 박정훈" },
    { u: "지원중대", s: "통신장비 운용", i: "중위 한통신" },
    { u: "1중대", s: "구급법 및 응급처치", i: "상사 최구급" },
    { u: "2중대", s: "체력 검정 (3km)", i: "상사 박안전" },
    { u: "3중대", s: "독도법 실습", i: "대위 김비룡" }
  ];

  for (let day = 1; day <= 31; day++) {
    let ddStr = day < 10 ? "0" + day : "" + day;
    let fullD = `2026-10-${ddStr}`;
    let dObj = new Date(2026, 9, day);
    let mon = getMonday(dObj);
    let wkKey = getWeekKey(mon);
    let dayOfWeek = dObj.getDay();
    let dayIdx = dayOfWeek === 0 ? 6 : dayOfWeek - 1;

    if (!scheduleData[wkKey]) scheduleData[wkKey] = [[],[],[],[],[],[],[]];

    let count = (dayOfWeek === 0 || dayOfWeek === 6) ? 1 : (day % 2 === 0 ? 3 : 2);
    
    for (let c = 0; c < count; c++) {
      let subIndex = (day + c) % sampleSubjects.length;
      let sub = sampleSubjects[subIndex];
      let startH = 8 + c * 3;
      let endH = startH + 2;
      let stStr = (startH < 10 ? "0" + startH : startH) + ":00";
      let etStr = (endH < 10 ? "0" + endH : endH) + ":00";
      
      let itemId = `item_oct_${day}_${c}`;
      if (!scheduleData[wkKey][dayIdx].some(x => x.id === itemId)) {
        scheduleData[wkKey][dayIdx].push({
          id: itemId,
          planTime: `${stStr}~${etStr}`,
          unit: sub.u,
          subject: sub.s,
          instructor: sub.i,
          dateStr: fullD
        });
      }
    }
  }
}
seedOctoberData();

function switchTab(tab) {
  currentTab = tab;
  document.getElementById("btn-tab-week").className = tab === 'week' ? "tab-btn active" : "tab-btn";
  document.getElementById("btn-tab-month").className = tab === 'month' ? "tab-btn active" : "tab-btn";
  document.getElementById("view-week").style.display = tab === 'week' ? "block" : "none";
  document.getElementById("view-month").style.display = tab === 'month' ? "block" : "none";
  
  if(tab === 'week') {
    document.getElementById("notice-title-text").innerText = "📢 주요 공지사항 (주간)";
    document.getElementById("notice-view").innerHTML = noticeData.week;
  } else {
    document.getElementById("notice-title-text").innerText = "📢 주요 공지사항 (월간)";
    document.getElementById("notice-view").innerHTML = noticeData.month;
  }
  
  if(editing) {
    editing = false;
    document.getElementById("notice-edit").style.display = "none";
    document.getElementById("notice-view").style.display = "block";
    document.getElementById("btn-notice").innerText = "수정";
  }

  if(tab === 'week') renderCalendar();
  else renderMonthCalendar();
}

function changeWeek(dir) {
  currentMonday.setDate(currentMonday.getDate() + (dir * 7));
  renderCalendar();
}

function changeMonth(dir) {
  currentMonthDate.setMonth(currentMonthDate.getMonth() + dir);
  renderMonthCalendar();
}

function toggleDateInput() {
  let val = document.getElementById("new-day-type").value;
  document.getElementById("div-week-day").style.display = val === 'week' ? "block" : "none";
  document.getElementById("div-exact-date").style.display = val === 'exact' ? "block" : "none";
}

function initTimeOptions() {
  let startSel = document.getElementById("start-time-select");
  let endSel = document.getElementById("end-time-select");
  startSel.innerHTML = ""; endSel.innerHTML = "";
  for (let h = 6; h <= 23; h++) {
    for (let m of [0, 30]) {
      let hh = h < 10 ? "0" + h : "" + h;
      let mm = m === 0 ? "00" : "30";
      let timeVal = `${hh}:${mm}`;
      startSel.appendChild(new Option(timeVal, timeVal));
      endSel.appendChild(new Option(timeVal, timeVal));
    }
  }
  startSel.value = "09:00"; endSel.value = "10:00";
}
initTimeOptions();

document.getElementById("btn-login").onclick = function() {
  if (document.getElementById("pw").value === "1234") {
    document.getElementById("gate").style.display = "none";
    document.getElementById("main").style.display = "block";
    switchTab('week');
  } else { alert("비밀번호 틀림!"); }
};

let editing = false;
document.getElementById("btn-notice").onclick = function() {
  let v = document.getElementById("notice-view");
  let e = document.getElementById("notice-edit");
  if (!editing) { 
    e.value = v.innerHTML.replace(/<br>/g, "\n"); 
    v.style.display = "none"; 
    e.style.display = "block"; 
    this.innerText = "저장"; 
    editing = true; 
  } else { 
    v.innerHTML = e.value.replace(/\n/g, "<br>"); 
    e.style.display = "none"; 
    v.style.display = "block"; 
    this.innerText = "수정"; 
    editing = false;
    
    if (currentTab === 'week') noticeData.week = v.innerHTML;
    else noticeData.month = v.innerHTML;
    localStorage.setItem("noticeData_v14", JSON.stringify(noticeData));
  }
};

document.getElementById("btn-add-toggle").onclick = function() {
  let b = document.getElementById("add-form");
  b.style.display = b.style.display === "block" ? "none" : "block";
};

document.getElementById("btn-add-submit").onclick = function() {
  let type = document.getElementById("new-day-type").value;
  let stVal = document.getElementById("start-time-select").value;
  let etVal = document.getElementById("end-time-select").value;
  let pt = `${stVal}~${etVal}`;
  let u = document.getElementById("new-unit").value;
  let s = document.getElementById("new-subject").value;
  let i = document.getElementById("new-instructor").value;
  if (!u || !s) { alert("부대와 과목을 입력하세요!"); return; }

  let targetDateStr = "";
  let weekKey = "";
  let dayIdx = 0;

  if (type === 'week') {
    dayIdx = parseInt(document.getElementById("new-day").value);
    let d = new Date(currentMonday);
    d.setDate(d.getDate() + dayIdx);
    targetDateStr = formatFullDate(d);
    weekKey = getWeekKey(currentMonday);
  } else {
    let exactVal = document.getElementById("new-exact-date").value;
    if(!exactVal) { alert("날짜를 선택하세요!"); return; }
    targetDateStr = exactVal;
    let dObj = new Date(exactVal);
    let mon = getMonday(dObj);
    weekKey = getWeekKey(mon);
    let day = dObj.getDay();
    dayIdx = day === 0 ? 6 : day - 1;
  }

  let newObj = { id: "item_" + Date.now(), planTime: pt, unit: u, subject: s, instructor: i || "교관", dateStr: targetDateStr };
  
  if (!scheduleData[weekKey]) scheduleData[weekKey] = [[],[],[],[],[],[],[]];
  if (!scheduleData[weekKey][dayIdx]) scheduleData[weekKey][dayIdx] = [];
  
  scheduleData[weekKey][dayIdx].push(newObj);
  localStorage.setItem("multiCalData_v14", JSON.stringify(scheduleData));
  
  document.getElementById("new-unit").value = "";
  document.getElementById("new-subject").value = "";
  document.getElementById("new-instructor").value = "";
  document.getElementById("add-form").style.display = "none";
  renderCalendar();
  renderMonthCalendar();
};

function renderCalendar() {
  let weekKey = getWeekKey(currentMonday);
  let weekNum = getWeekNumber(currentMonday);
  let days = ["월", "화", "수", "목", "금", "토", "일"];
  let dates = [];
  let tempDate = new Date(currentMonday);
  for(let i=0; i<7; i++) {
    dates.push({
      formatted: formatDate(tempDate), 
      full: formatFullDate(tempDate),
      dayOfWeek: tempDate.getDay(),
      mmdd: (tempDate.getMonth()+1 < 10 ? "0"+(tempDate.getMonth()+1) : tempDate.getMonth()+1) + "-" + (tempDate.getDate() < 10 ? "0"+tempDate.getDate() : tempDate.getDate())
    });
    tempDate.setDate(tempDate.getDate() + 1);
  }

  document.getElementById("week-title").innerText = `${weekNum}주차 (${dates[0].formatted} ~ ${dates[6].formatted})`;

  let g = document.getElementById("calendar-grid");
  g.innerHTML = "";
  for (let i=0; i<7; i++) {
    let h = document.createElement("div");
    let isSat = dates[i].dayOfWeek === 6;
    let isSun = dates[i].dayOfWeek === 0;
    h.className = "cal-hdr" + (isSat ? " sat" : "") + (isSun ? " sun" : ""); 
    h.innerText = days[i]; 
    g.appendChild(h);
  }

  if (!scheduleData[weekKey]) scheduleData[weekKey] = [[],[],[],[],[],[],[]];

  for (let i=0; i<7; i++) {
    let items = scheduleData[weekKey][i] || [];
    items.sort((a, b) => a.planTime.split("~")[0].trim().localeCompare(b.planTime.split("~")[0].trim()));

    let isSat = dates[i].dayOfWeek === 6;
    let isSun = dates[i].dayOfWeek === 0;
    let holName = holidays[dates[i].mmdd];
    let isHol = !!holName;

    let dateColorStyle = isHol || isSun ? "color:#f87171;" : (isSat ? "color:#60a5fa;" : "color:#38bdf8;");

    let cell = document.createElement("div");
    cell.className = "cal-cell";
    cell.innerHTML = `<div style="text-align:center;font-size:9px;font-weight:bold;margin-bottom:2px;${dateColorStyle}">${dates[i].formatted}${isHol ? `<br><span style="font-size:7px;">${holName}</span>` : ''}</div>`;
    
    for (let item of items) {
      let st = localStorage.getItem(item.id + "_s") || "-";
      let et = localStorage.getItem(item.id + "_e") || "-";
      let div = document.createElement("div");
      div.className = "item";
      div.innerHTML = `<div style="color:#f59e0b;font-weight:bold;">🕒 ${item.planTime}</div><b style="color:#38bdf8;">${item.unit}</b> ${item.subject}<br><span style="color:#94a3b8;">${item.instructor}</span><br><span style="color:#4ade80;">시작: ${st}</span><br><span style="color:#f87171;">종료: ${et}</span>`;
      div.onclick = function(e) { e.stopPropagation(); openModal(item.id, days[i], dates[i].formatted, item.unit, item.subject, item.instructor, item.planTime); };
      cell.appendChild(div);
    }
    g.appendChild(cell);
  }
}

function renderMonthCalendar() {
  let y = currentMonthDate.getFullYear();
  let m = currentMonthDate.getMonth();
  document.getElementById("month-title").innerText = `${y}년 ${m + 1}월`;

  let g = document.getElementById("month-grid");
  g.innerHTML = "";
  let days = ["일", "월", "화", "수", "목", "금", "토"];
  for (let i = 0; i < 7; i++) {
    let h = document.createElement("div");
    let isSat = i === 6;
    let isSun = i === 0;
    h.className = "cal-hdr" + (isSat ? " sat" : "") + (isSun ? " sun" : ""); 
    h.innerText = days[i]; 
    g.appendChild(h);
  }

  let firstDayIndex = new Date(y, m, 1).getDay();
  let lastDay = new Date(y, m + 1, 0).getDate();

  let allItemsMap = {};
  for (let wk in scheduleData) {
    let weekDays = scheduleData[wk];
    if (weekDays) {
      weekDays.forEach(dayList => {
        if (dayList) {
          dayList.forEach(item => {
            if (item.dateStr) {
              if (!allItemsMap[item.dateStr]) allItemsMap[item.dateStr] = [];
              allItemsMap[item.dateStr].push(item);
            }
          });
        }
      });
    }
  }

  for (let i = 0; i < firstDayIndex; i++) {
    let emptyCell = document.createElement("div");
    emptyCell.className = "month-cell";
    emptyCell.style.opacity = "0.2";
    g.appendChild(emptyCell);
  }

  for (let day = 1; day <= lastDay; day++) {
    let mm = m + 1 < 10 ? "0" + (m + 1) : "" + (m + 1);
    let dd = day < 10 ? "0" + day : "" + day;
    let dateStr = `${y}-${mm}-${dd}`;
    let mmddKey = `${mm}-${dd}`;
    
    let dObj = new Date(y, m, day);
    let dayOfWeek = dObj.getDay();
    let isSat = dayOfWeek === 6;
    let isSun = dayOfWeek === 0;
    let holName = holidays[mmddKey];
    let isHol = !!holName;

    let dateColorStyle = isHol || isSun ? "color:#f87171;" : (isSat ? "color:#60a5fa;" : "color:#f8fafc;");

    let cell = document.createElement("div");
    cell.className = "month-cell";
    cell.innerHTML = `<div style="font-size:9px;font-weight:bold;margin-bottom:2px;${dateColorStyle}">${day}${isHol ? `<span style="font-size:7px;margin-left:2px;color:#f87171;">${holName}</span>` : ''}</div>`;

    let dayItems = allItemsMap[dateStr] || [];
    dayItems.sort((a, b) => a.planTime.split("~")[0].trim().localeCompare(b.planTime.split("~")[0].trim()));

    for (let item of dayItems) {
      let mDiv = document.createElement("div");
      mDiv.className = "month-item";
      mDiv.innerText = `${item.planTime.split('~')[0]} ${item.subject}`;
      mDiv.onclick = function(e) {
        e.stopPropagation();
        openModal(item.id, `${m+1}월 ${day}일`, dateStr, item.unit, item.subject, item.instructor, item.planTime);
      };
      cell.appendChild(mDiv);
    }
    g.appendChild(cell);
  }
}

function openModal(id, dayName, dateStr, unit, subject, instructor, planTime) {
  currentSubId = id;
  let st = localStorage.getItem(id + "_s") || "미기록";
  let et = localStorage.getItem(id + "_e") || "미기록";
  document.getElementById("m-title").innerText = `${dayName} (${dateStr}) 상세`;
  document.getElementById("m-body").innerHTML = `<b>계획 시간:</b> ${planTime}<br><b>부대:</b> ${unit}<br><b>과목:</b> ${subject}<br><b>교관:</b> ${instructor}`;
  document.getElementById("m-log").innerHTML = `<span style="color:#4ade80;">🟢 시작: ${st}</span><br><span style="color:#f87171;">🔴 종료: ${et}</span>`;
  document.getElementById("modal").style.display = "flex";
}

document.getElementById("btn-start").onclick = function() {
  let t = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
  localStorage.setItem(currentSubId + "_s", t);
  openModal(currentSubId, "", "", "", "", "", "");
  renderCalendar();
  if(currentTab === 'month') renderMonthCalendar();
};

document.getElementById("btn-end").onclick = function() {
  let t = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
  localStorage.setItem(currentSubId + "_e", t);
  openModal(currentSubId, "", "", "", "", "", "");
  renderCalendar();
  if(currentTab === 'month') renderMonthCalendar();
};

document.getElementById("btn-delete").onclick = function() {
  if (confirm("정말 이 교육 일정을 삭제하시겠습니까?")) {
    for (let wk in scheduleData) {
      let weekDays = scheduleData[wk];
      if (weekDays) {
        for (let i = 0; i < weekDays.length; i++) {
          scheduleData[wk][i] = weekDays[i].filter(item => item.id !== currentSubId);
        }
      }
    }
    localStorage.setItem("multiCalData_v14", JSON.stringify(scheduleData));
    localStorage.removeItem(currentSubId + "_s");
    localStorage.removeItem(currentSubId + "_e");
    document.getElementById("modal").style.display = "none";
    renderCalendar();
    if(currentTab === 'month') renderMonthCalendar();
  }
};

document.getElementById("btn-close").onclick = function() {
  document.getElementById("modal").style.display = "none";
};
</script></body></html>
